
# --- KwizeraGate Environment Variables ---
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite — zero setup):
DATABASE_URL=sqlite:///./kwizeragate.db

# Docker / Production (PostgreSQL — uncomment and set for Docker Compose):
# DATABASE_URL=postgresql://kwizera:kwizerapass@db:5432/kwizeragate

# ── Application ─────────────────────────────────────────────────────────────
# Strong random secret for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret-key

# Set to "production" to activate real IBM API calls (stubs are the fallback).
APP_ENV=development

# Comma-separated allowed CORS origins. Use * for development only.
# Production example: ALLOWED_ORIGINS=https://merchant.burundipay.bi,https://admin.kwizeragate.bi
ALLOWED_ORIGINS=*

# ── IBM Verify (Adaptive MFA) ────────────────────────────────────────────────
# IBM Verify → Administration → Tenant Settings → Tenant URL
IBM_VERIFY_TENANT_URL=https://your-tenant.verify.ibm.com

# IBM Verify → API Clients → Create Client
IBM_VERIFY_CLIENT_ID=your-verify-client-id
IBM_VERIFY_CLIENT_SECRET=your-verify-client-secret

# ── IBM QRadar (SIEM) ────────────────────────────────────────────────────────
# QRadar console hostname or IP
QRADAR_HOST=https://your-qradar-host.example.com

# QRadar → Admin → Authorized Services → Add Token
QRADAR_TOKEN=your-qradar-auth-token

# ── Burundi Network Config ───────────────────────────────────────────────────
# Comma-separated CIDR subnets treated as trusted Bujumbura origins.
# Defaults are MTN Burundi (196.41.0.0/16) and ONATEL Burundi (41.186.0.0/16).
BUJUMBURA_SUBNETS=196.41.0.0/16,41.186.0.0/16
